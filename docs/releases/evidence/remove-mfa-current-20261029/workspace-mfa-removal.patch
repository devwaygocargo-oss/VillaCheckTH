+// Disposable local fixtures only. Legacy encrypted factors remain private history.
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import {randomBytes,createHash} from 'node:crypto'
+import {merchantFixture} from './merchant-test-fixture.mjs'
+
+const digest=value=>createHash('sha256').update(value).digest('hex')
+const legacyState=async f=>f.db.prepare("SELECT key,value FROM system_settings WHERE key LIKE 'privileged_mfa:%' OR key LIKE 'mfa_%' ORDER BY key").all()
+
+test('User, Merchant and Admin password login ignore obsolete factor settings without changing roles or legacy data',async t=>{
+ const f=await merchantFixture({privilegedMfaRequired:true,adminMfaKey:'OBSOLETE_INVALID_AND_IGNORED'})
+ t.after(()=>f.close())
+ for(const prefix of ['privileged_mfa:','mfa_pending:','mfa_bootstrap:','mfa_stepup:'])await f.db.prepare('INSERT INTO system_settings(key,value) VALUES (?,?)').run(prefix+f.admin.id,'LOCAL_UNREADABLE_LEGACY_STATE')
+ const before=await legacyState(f)
+ for(const actor of [f.other,f.legacy,f.admin]){
+  const login=await f.expect(actor.role==='admin'?'/auth/admin-login':'/auth/login',{email:actor.email,password:'LocalPassword123',role:actor.role==='admin'?'user':'admin',mfaCode:'IGNORED_OBSOLETE_FIELD',recoveryCode:'IGNORED_OBSOLETE_FIELD'})
+  assert.equal(login.body.user.id,actor.id);assert.equal(login.body.user.role,actor.role)
+  const session={cookie:login.cookie,csrf:login.body.csrf},me=actor.role==='admin'?'/auth/admin-me':'/auth/me'
+  assert.equal((await f.expect(me,undefined,session)).body.user.id,actor.id)
+  assert.equal((await f.db.prepare('SELECT role FROM users WHERE id=?').get(actor.id)).role,actor.role)
+  const token=login.cookie.match(/=(\w+)/)[1],stored=await f.db.prepare('SELECT token_hash FROM sessions WHERE user_id=? AND token_hash=?').get(actor.id,digest(token))
+  assert(stored&&stored.token_hash===digest(token));assert(stored.token_hash!==token)
+  await f.expect(actor.role==='admin'?'/auth/admin-logout':'/auth/logout',{},session)
+  await f.expect(me,undefined,session,401)
+ }
+ assert.deepEqual(await legacyState(f),before)
+ const config=(await f.expect('/config')).body
+ assert(!Object.keys(config).some(key=>/mfa/i.test(key)))
+})
+
+test('Retired enrollment, confirmation, status and challenge endpoints cannot expose or mutate retained factors',async t=>{
+ const f=await merchantFixture();t.after(()=>f.close())
+ await f.db.prepare('INSERT INTO system_settings(key,value) VALUES (?,?)').run('privileged_mfa:'+f.admin.id,JSON.stringify({enabled:true,secret:'LOCAL_RETAINED_ENCRYPTED_FIXTURE',recoveryHashes:['LOCAL_UNUSED_HASH'],blockedUntil:Date.now()+3600000}))
+ const before=await legacyState(f),admin=await f.login(f.admin)
+ for(const path of ['status','enroll','confirm','step-up']){
+  const response=await f.expect('/auth/mfa/'+path,path==='status'?undefined:{code:'000000'},admin,404)
+  assert(!/secret|recoveryCodes|bootstrapRequired/.test(JSON.stringify(response.body)))
+ }
+ assert.deepEqual(await legacyState(f),before)
+ await f.expect('/auth/admin-me',undefined,admin)
+})
+
+test('Existing Admin sessions need no step-up record while CSRF, role boundaries and logout remain enforced',async t=>{
+ const f=await merchantFixture({privilegedMfaRequired:true});t.after(()=>f.close())
+ await f.db.prepare('INSERT INTO system_settings(key,value) VALUES (?,?)').run('privileged_mfa:'+f.admin.id,'LOCAL_INVALID_JSON_MUST_NOT_BE_PARSED')
+ const token=randomBytes(32).toString('hex'),admin={cookie:'vc_admin_session='+token,csrf:randomBytes(24).toString('hex')}
+ await f.db.prepare('INSERT INTO sessions VALUES (?,?,?,?)').run(digest(token),f.admin.id,admin.csrf,Date.now()+60000)
+ await f.expect('/auth/admin-me',undefined,admin)
+ await f.expect('/admin/accounts?role=user',undefined,admin)
+ const user=await f.login(f.other),merchant=await f.login(f.legacy)
+ await f.expect('/admin/accounts?role=user',undefined,user,403)
+ await f.expect('/admin/accounts?role=user',undefined,merchant,403)
+ await f.expect('/auth/admin-login',{email:f.other.email,password:'LocalPassword123'},undefined,403)
+ await f.expect('/auth/login',{email:f.admin.email,password:'LocalPassword123'},undefined,403)
+ await f.expect('/auth/admin-logout',{}, {...admin,csrf:'INVALID_CSRF'},403)
+ await f.expect('/auth/admin-me',undefined,admin)
+ await f.expect('/auth/admin-logout',{},admin)
+ await f.expect('/auth/admin-me',undefined,admin,401)
+})
+
+test('Generic suspension and incorrect credentials still deny access after factor enforcement is removed',async t=>{
+ const f=await merchantFixture();t.after(()=>f.close())
+ await f.expect('/auth/admin-login',{email:f.admin.email,password:'IncorrectLocalPassword'},undefined,401)
+ const admin=await f.login(f.admin)
+ await f.db.prepare('INSERT INTO system_settings(key,value) VALUES (?,?)').run('account_status:'+f.admin.id,JSON.stringify({status:'suspended',reason:'LOCAL_EXISTING_SECURITY_HOLD'}))
+ await f.expect('/auth/admin-me',undefined,admin,403)
+ await f.expect('/auth/admin-login',{email:f.admin.email,password:'LocalPassword123'},undefined,403)
+ assert.equal(JSON.parse((await f.db.prepare('SELECT value FROM system_settings WHERE key=?').get('account_status:'+f.admin.id)).value).status,'suspended')
+ assert.equal((await f.db.prepare('SELECT role FROM users WHERE id=?').get(f.admin.id)).role,'admin')
+})
